{
  "manifest_version": 3,
  "name": "YT Downloader",
  "version": "0.2.0",
  "minimum_chrome_version": "124",
  "description": "Baixe vídeos com áudio, thumbnails e legendas usando o próprio navegador. Sem programas externos.",
  "key": "",
  "permissions": [
    "downloads",
    "offscreen",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": ["https://www.youtube.com/*", "https://*.googlevideo.com/*", "https://i.ytimg.com/*"],
  "action": { "default_title": "YT Downloader" },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
