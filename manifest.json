{
  "manifest_version": 3,
  "name": "YT Downloader",
  "version": "0.1.0",
  "description": "Botao sobre videos e thumbnails do YouTube para baixar video (com escolha de qualidade), thumbnail ou legendas via yt-dlp local. Downloads aparecem no Chrome.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "downloads"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
